#!name=天府通去广告
#!desc=去掉天府通 App 开屏/弹窗/浮窗/首页横幅与营销卡片。乘车码、充值、余额、地图不拦截。依据 2026-10-26 TFTAPP 9.5.0 抓包。
#!author=acupMist
#!homepage=https://github.com/acupMist/loon-rules

[MITM]
hostname = tft-app.cdtft.cn, shequ.cdtft.cn, metroact.cdtft.cn, ams-cdn.cdtft.cn

[Script]
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*getOfficialAndBakAdvByPositionCode script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@main/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通广告位
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*message\/(popup|float\/window|activity\/messages) script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@main/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通弹窗浮窗
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*pageMarketing script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@main/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通乘车码营销
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*affiliation\/popup script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@main/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通附属弹窗
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*discountCard\/getMergePopup script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@main/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通折扣卡弹窗
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*getQrCodePageFunctionList script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@main/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通乘车码页功能
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*\/wda\/(calendar|daily\/) script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@main/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通福利日历
http-response ^https?:\/\/[^\/]*cdtft\.cn\/prod\/\d{8}\/\d+_\d+\.json script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@main/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通首页布局
