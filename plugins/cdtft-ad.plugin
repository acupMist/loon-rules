#!name=天府通去广告
#!desc=去掉天府通 App 开屏/弹窗/浮窗/首页广告、福利推荐、乘车码页滚动广告、财富页与资讯流、优惠券角标，并移除底部“财富”菜单。乘车码、充值、余额、地图不拦截。依据 2026-11-16 TFTAPP 9.6.0 抓包。
#!author=acupMist
#!homepage=https://github.com/acupMist/loon-rules

[MITM]
hostname = tft-app.cdtft.cn, shequ.cdtft.cn, metroact.cdtft.cn, ams-cdn.cdtft.cn, smpex.cdtft.cn

[Script]
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*tft-ams\/api\/appAd\/ script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通广告位
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*message\/(popup|float\/window|activity\/messages) script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通弹窗浮窗
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*pageMarketing script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通乘车码营销
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*affiliation\/popup script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通附属弹窗
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*discountCard\/getMergePopup script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通折扣卡弹窗
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*getQrCodePageFunctionList script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通乘车码页功能
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*getWealthPageFunctionList script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通财富页功能
http-response ^https?:\/\/smpex\.cdtft\.cn\/.*get(RedStarNewsByTypeId|FinancialInformationType) script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通财富资讯
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*(myCouponCountGateway|discountAndCouponNum) script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通优惠券角标
http-response ^https?:\/\/[^\/]*cdtft\.cn\/.*\/wda\/(calendar|daily\/) script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通福利日历
http-response ^https?:\/\/[^\/]*cdtft\.cn\/prod\/\d{8}\/\d+_\d+\.json script-path=https://cdn.jsdelivr.net/gh/acupMist/loon-rules@2575f795c26b6876259f86968ca13f2421fec943/scripts/cdtft-ad.js, requires-body=true, timeout=10, tag=天府通首页布局
