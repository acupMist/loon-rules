#!name=AgentRouter 模型请求 UA
#!desc=按接口改写 AgentRouter 模型请求的 User-Agent：Messages 用 Claude Code UA，其余 /v1/ 接口用 Codex UA。覆盖 ZCode、OpenCode、Pi、Claude Code、Codex、DSH 发出的直连本站 API 请求；两种 UA 均可修改，留空则保留原值。目标 UA 已正确时不改写。有正文时捕获并回传，避免 Loon Mac 把 Content-Length 写成 0。不改鉴权、不改分流。需要 HTTPS 解密与客户端信任 Loon CA。
#!author=acupMist
#!homepage=https://github.com/acupMist/loon-rules

[Argument]
claudeUA=input, "claude-cli/2.1.197 (external, cli)", tag=Claude Code UA, desc=/v1/messages 及其子路径使用的 User-Agent；留空保留原值；填写单行 ASCII 文本
codexUA=input, "codex_cli_rs/0.170.0", tag=Codex UA, desc=其余 /v1/ 接口使用的 User-Agent；留空保留原值；填写单行 ASCII 文本
rewrite=switch, true, tag=启用 UA 改写, desc=关闭后不执行请求头改写

[MITM]
hostname = agentrouter.org, www.agentrouter.org

[Script]
http-request ^https://(?:www\.)?agentrouter\.org(?::443)?/v1/(?:messages|responses|chat/completions|completions)(?:[/?#].*)?$ script-path=https://raw.githubusercontent.com/acupMist/loon-rules/ecf85085b860df97a8b829187115fe28e8dfe6ff/scripts/agentrouter-user-agent.js, requires-body=true, timeout=15, tag=AgentRouter模型UA, argument=[{claudeUA},{codexUA}], enable={rewrite}
http-request ^https://(?:www\.)?agentrouter\.org(?::443)?/v1/(?!messages(?:[/?#]|$)|responses(?:[/?#]|$)|chat/completions(?:[/?#]|$)|completions(?:[/?#]|$))[^#]*$ script-path=https://raw.githubusercontent.com/acupMist/loon-rules/ecf85085b860df97a8b829187115fe28e8dfe6ff/scripts/agentrouter-user-agent.js, requires-body=false, timeout=5, tag=AgentRouter模型UA无正文, argument=[{claudeUA},{codexUA}], enable={rewrite}
