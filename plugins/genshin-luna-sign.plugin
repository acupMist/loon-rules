#!name=原神签到
#!desc=米游社原神每日签到（国服 luna/hk4e）。需先用「原神Cookie捕获」插件保存 Cookie。
#!author=acupMist
#!homepage=https://github.com/acupMist/loon-rules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Available.png

[Argument]
cron=input, "0 9 * * *", tag=签到时间, desc=CRON 表达式，默认每天 9:00
notify=switch, true, tag=通知, desc=是否发送签到结果通知

[Script]
cron {cron} script-path=https://raw.githubusercontent.com/acupMist/loon-rules/main/scripts/genshin-luna-sign.js?v=20260921b, timeout=60, tag=原神签到, argument=[{notify}]
