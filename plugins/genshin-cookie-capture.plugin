#!name=原神Cookie捕获
#!desc=访问米游社原神签到相关接口时自动保存 Cookie。捕获完成后请在插件参数里关闭「启用捕获」。
#!author=acupMist
#!homepage=https://github.com/acupMist/loon-rules

[Argument]
capture=switch, true, tag=启用捕获, desc=关闭后不再拦截/保存 Cookie（建议捕获成功后关掉）

[MITM]
hostname = api-takumi.mihoyo.com, passport-api.mihoyo.com, act.mihoyo.com

[Script]
http-request ^https:\/\/(api-takumi\.mihoyo\.com\/event\/luna\/hk4e\/|passport-api\.mihoyo\.com\/account\/ma-cn-session|act\.mihoyo\.com\/bbs\/event\/signin) script-path=https://raw.githubusercontent.com/acupMist/loon-rules/main/scripts/genshin-cookie-capture.js?v=20260921b, requires-body=false, timeout=10, tag=原神Cookie捕获, argument=[{capture}]
